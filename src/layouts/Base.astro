---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Hero pages sit under a transparent nav; inner pages get top padding. */
  flush?: boolean;
}

const { title, description = site.description, flush = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0d0f12" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/og.jpg', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MusicGroup',
        name: site.name,
        url: site.url,
        genre: ['Hip Hop', 'Afro', 'Bass', 'House'],
        address: {
          '@type': 'PostalAddress',
          addressLocality: site.city,
          addressCountry: 'IN',
        },
      })}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:text-ink"
      >Skip to content</a
    >
    <Nav />
    <main id="main" class={flush ? '' : 'pt-24'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
