---
import { whatsappLink } from '../data/site';
---

<section class="relative overflow-hidden border-b border-line py-20 sm:py-28">
  <!-- Soft gold bloom, purely decorative. -->
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full"
    style="background: radial-gradient(circle, rgba(251,235,6,0.08) 0%, transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="max-w-3xl font-display text-[clamp(2rem,6vw,4rem)] leading-[0.95] text-bone">
      Your next event deserves a DJ who's seen everything.
    </h2>
    <p class="mt-5 text-[11px] uppercase tracking-[0.18em] text-muted">
      Club Nights · Festivals · Weddings · Campus · Corporate
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/book" class="btn btn-primary">Check Availability</a>
      <a href={whatsappLink()} rel="noopener" class="btn btn-ghost">WhatsApp Directly</a>
    </div>

    <p class="mt-6 text-[13px] text-muted">Book early — weekend dates fill fast.</p>
  </div>
</section>
