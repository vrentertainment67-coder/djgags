---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="mb-10">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.25rem)] text-bone">{title}</h2>
  {lede && <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted">{lede}</p>}
</div>
