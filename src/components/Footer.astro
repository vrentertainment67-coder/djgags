---
import { site, contact, nav, whatsappLink } from '../data/site';
import Wordmark from './Wordmark.astro';
const year = new Date().getFullYear();

const socials = [
  { href: contact.instagramUrl, label: 'Instagram', show: Boolean(contact.instagram) },
  { href: contact.youtube, label: 'YouTube', show: Boolean(contact.youtube) },
  { href: contact.soundcloud, label: 'SoundCloud', show: Boolean(contact.soundcloud) },
].filter((s) => s.show);
---

<footer class="border-t border-line bg-ink">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div>
        <div class="text-gold">
          <Wordmark height="2.5rem" />
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          {site.role}. {site.city}. Residencies, festivals, campus and corporate
          bookings across India.
        </p>
      </div>

      <nav class="flex flex-col gap-2.5" aria-label="Footer">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
            >
              {item.label}
            </a>
          ))
        }
        <a href="/book" class="text-[11px] uppercase tracking-[0.16em] text-gold">Book</a>
      </nav>

      <div class="flex flex-col gap-2.5">
        <a
          href={whatsappLink()}
          class="text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
          rel="noopener">WhatsApp {contact.whatsappDisplay}</a
        >
        <a
          href={`mailto:${contact.email}`}
          class="text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
          >{contact.email}</a
        >
        <a
          href={`mailto:${contact.labelEmail}`}
          class="text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
          >{contact.label} · {contact.labelEmail}</a
        >
        {
          socials.map((s) => (
            <a
              href={s.href}
              rel="noopener"
              class="text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="text-[10px] uppercase tracking-[0.16em] text-muted">
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>
