---
import { stats } from '../data/site';
---

<section class="border-b border-line">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-line sm:grid-cols-4">
    {
      stats.map((s) => (
        <div class="bg-ink px-5 py-9 text-center">
          <p class="font-display text-4xl leading-none text-gold sm:text-5xl">{s.value}</p>
          <p class="mt-2.5 text-[10px] uppercase leading-relaxed tracking-[0.16em] text-muted">
            {s.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
