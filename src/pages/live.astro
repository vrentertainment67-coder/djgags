---
import Base from '../layouts/Base.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { contact } from '../data/site';
---

<Base
  title="Live"
  description="Recent nights, clips and moments from DJ Gags — straight from Instagram."
>
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="eyebrow">Live Moments</p>
      <h1 class="mt-5 max-w-2xl font-display text-[clamp(2.5rem,8vw,5rem)] leading-[0.92] text-bone">
        The nights, as they happen.
      </h1>
      <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-muted">
        Clips, crowds and behind-the-booth moments — updated from Instagram.
      </p>
      <a href={contact.instagramUrl} rel="noopener" class="btn btn-primary mt-8">
        Follow @{contact.instagram}
      </a>
    </div>
  </section>

  <section class="border-y border-line py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <!--
        Behold widget (behold.so). Serves a cached feed, so Instagram
        rate-limiting degrades this section rather than breaking the page.
        Feed config — layout, post count, domain whitelist — lives in the
        Behold dashboard, not here; only the feed id is ours.
      -->
      <div class="behold-frame border border-line bg-surface p-4 sm:p-6">
        <behold-widget feed-id="xbKVMdkYSAiR4l94BxqO"></behold-widget>
      </div>

      <!-- is:inline keeps Astro from bundling a third-party loader that
           expects to run as-is. -->
      <script is:inline>
        (() => {
          if (window.__bhldScript) return;
          window.__bhldScript = true;
          const d = document,
            s = d.createElement('script');
          s.type = 'module';
          s.src = 'https://w.behold.so/widget.js';
          setTimeout(() => {
            d.head.append(s);
          }, 0);
        })();
      </script>

      <p class="mt-5 text-[13px] text-muted">
        Feed updates automatically from
        <a href={contact.instagramUrl} rel="noopener" class="text-gold underline underline-offset-4"
          >@{contact.instagram}</a
        >.
      </p>
    </div>
  </section>

  <BookingCTA />
</Base>

<style>
  /* The widget is a web component with its own shadow DOM, so it can only be
     sized from the outside — hence the wrapper rather than deep selectors. */
  .behold-frame behold-widget {
    display: block;
    min-height: 12rem;
  }
</style>
