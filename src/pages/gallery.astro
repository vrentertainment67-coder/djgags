---
import Base from '../layouts/Base.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { gallery, images } from '../data/site';

// Fall back to the four supplied press shots until a fuller gallery exists.
const shots =
  gallery.length > 0
    ? gallery
    : [
        { src: images.hero, alt: 'DJ Gags with arms raised, crowd behind him', caption: 'Peak hour' },
        { src: images.booth, alt: 'DJ Gags behind the CDJs, shot from the floor', caption: 'In the booth' },
        { src: images.daytime, alt: 'DJ Gags playing an outdoor daytime set', caption: 'Day event' },
        { src: images.portrait, alt: 'Studio portrait of DJ Gags', caption: 'Portrait' },
      ];
---

<Base title="Gallery" description="Photographs from behind the decks — DJ Gags live.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="eyebrow">The Visual Record</p>
      <h1 class="mt-5 max-w-2xl font-display text-[clamp(2.5rem,8vw,5rem)] leading-[0.92] text-bone">
        Gallery.
      </h1>
    </div>
  </section>

  <section class="border-y border-line py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
        {
          shots.map((shot) => (
            <figure class="group break-inside-avoid border border-line">
              <img
                src={shot.src}
                alt={shot.alt}
                loading="lazy"
                decoding="async"
                class="w-full object-cover transition duration-500 group-hover:brightness-110"
              />
              {shot.caption && (
                <figcaption class="border-t border-line px-4 py-3 text-[10px] uppercase tracking-[0.18em] text-muted">
                  {shot.caption}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <BookingCTA />
</Base>
